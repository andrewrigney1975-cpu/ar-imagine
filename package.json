{
  "name": "imagine",
  "productName": "Imagine",
  "version": "1.3.0",
  "description": "Imagine image creation and editing tools",
  "author": "Andrew Rigney",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron electron/make-icon.js",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "android:sync": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.mkdirSync('www');fs.copyFileSync('imagine.html','www/index.html');for(const f of ['manifest.webmanifest','pwa.js'])fs.copyFileSync(f,'www/'+f);fs.cpSync('icons','www/icons',{recursive:true})\" && cap sync android"
  },
  "build": {
    "appId": "com.andrewrigney.imagine",
    "productName": "Imagine",
    "files": [
      "electron/main.js",
      "imagine.html",
      "manifest.webmanifest",
      "pwa.js",
      "icons/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Graphics"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.4.5": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
